# ===== 秒杀系统生产环境变量模板 =====
# 复制为 .env 并修改密码后使用
# 启动: docker compose --env-file .env up -d

# ===== MySQL =====
MYSQL_MASTER_ROOT_PASSWORD=change_me_master_2026
MYSQL_SLAVE_ROOT_PASSWORD=change_me_slave_2026

# ===== Redis =====
REDIS_PASSWORD=change_me_redis_2026

# ===== RabbitMQ =====
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change_me_mq_2026

# ===== Grafana =====
GRAFANA_ADMIN_PASSWORD=change_me_admin_2026

# ===== 应用密钥 =====
MIAOSHA_JWT_SECRET=change_me_jwt_secret_32_bytes_min
MIAOSHA_SERVER_SIGN_SECRET=change_me_sign_secret_32_bytes_min

# ===== 钉钉告警（可选，不填则不发送告警） =====
DINGTALK_WEBHOOK=

# ===== 性能调优 =====
GOMAXPROCS=4
GOGC=200
GOMEMLIMIT=2GiB